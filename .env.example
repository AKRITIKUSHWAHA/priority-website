# Priority Hauliers Environment Variables Example

# Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API Key (Optional email provider)
RESEND_API_KEY=re_123456789_abcdefg

# Nodemailer / SMTP Configuration (Optional email provider)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=hello@priorityhauliers.com
NOTIFICATION_EMAIL=dispatch@priorityhauliers.com
